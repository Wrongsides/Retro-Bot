# Server
PORT=8080

# Set to "true" to use in-memory data instead of calling real Jira/Miro/GitHub APIs.
# Recommended for local development and demos — no real credentials required.
USE_NULL_CLIENTS=true

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=RETRO

# --- Miro ---
MIRO_ACCESS_TOKEN=
MIRO_DEFAULT_BOARD_ID=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPO=your-repo

# --- LLM ---
# With USE_NULL_CLIENTS=true, the canned response does not produce sentiment scores.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
# Legacy variable name; bearer token for any OpenAI-compatible provider (ignored by Ollama).
GITHUB_MODELS_TOKEN=ollama

# --- Feedback store ---
# Relative to mcp/ when using the package scripts; live-client mode only.
FEEDBACK_STORE_PATH=data/feedback.json
