# Bot Framework registration (from Azure Bot resource / Teams Developer Portal)
MicrosoftAppType=MultiTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# Local Bot Framework endpoint port (Azure Bot / Emulator posts activities here)
PORT=3978

# retro-bot MCP server this bot proxies tool calls to
MCP_SERVER_URL=http://localhost:8080/mcp
# Optional bearer token sent by the client; the current MCP server does not validate it.
MCP_SERVER_TOKEN=
